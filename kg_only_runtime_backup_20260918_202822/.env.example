OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

OPENROUTER_TEMPERATURE=0
OPENROUTER_MAX_TOKENS=1200
OPENROUTER_MAX_RETRIES=3
OPENROUTER_TIMEOUT_SECONDS=120
OPENROUTER_REASONING=off

DATA_DIR=Data
MODEL_PATH=models/catboost_attrition_model.cbm

SUCCESSOR_LLM_ENABLED=false
SUCCESSOR_OPENROUTER_TIMEOUT_SECONDS=90
SUCCESSOR_OPENROUTER_MAX_TOKENS=900
# Comma-separated frontend origins allowed to call this API from a browser.
# "*" allows any origin, which is safe here only because there are no cookies.
# Supabase Authentication
# Supabase Authentication

AUTH_ENABLED=true

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

AUTH_EMAIL_VERIFY_REDIRECT_URL=
AUTH_PASSWORD_RESET_REDIRECT_URL=

AUTH_PUBLIC_PATHS=/health,/openapi.json,/auth/signup,/auth/login,/auth/resend-verification,/auth/forgot-password
AUTH_PUBLIC_PREFIXES=/docs,/redoc


# HR Decision Trigger Engine
# Current project phase: CSV input + CSV case workflow storage.
DECISION_CASE_DATA_SOURCE=csv
DECISION_CASE_STORAGE=csv
DECISION_CASE_CSV_FILE=HR_Decision_Cases.csv
DECISION_CASE_SOURCE_MAP=HR_Decision_Data_Source_Map.csv
DECISION_CASE_DASHBOARD_LIMIT=5

# Future Supabase switch (no rule/API code change required):
# DECISION_CASE_DATA_SOURCE=supabase
# DECISION_CASE_STORAGE=supabase
# DECISION_CASE_TABLE=hr_decision_cases

# Roadmap Step 9 runtime source switching.
# legacy      = current CSV/runtime only
# graph_first = Knowledge Graph for employee + attrition, safe legacy fallback if unavailable
# graph_only  = fail startup if graph runtime is unavailable
STEP9_RUNTIME_MODE=graph_first
STEP9_TENANT_ID=ORGANIZATION-001
STEP9_ALLOW_LEGACY_FALLBACK=true
STEP9_VERIFY_GRAPH_CONNECTIVITY=true

# Step 10 Ontology Studio
ONTOLOGY_STUDIO_ADMIN_ROLES=admin,owner,hr_admin,super_admin

# Step 11 Existing HR Application UI Integration
STEP11_APP_NAME=HR Workforce Intelligence
STEP11_ONTOLOGY_STUDIO_NAV=true
STEP11_REFERENCE_CONSOLE=true
STEP11_ADMIN_ROLES=admin,owner,hr_admin,super_admin

# Step 12 Multi-Organization Onboarding
STEP12_DEFAULT_ORGANIZATION_NAME=Current Organization
STEP12_DEFAULT_TENANT_OPEN_ACCESS=true
STEP12_GLOBAL_ADMIN_ROLES=super_admin,platform_admin
STEP12_CREATE_ORG_ROLES=super_admin,platform_admin,admin,owner,hr_admin

# Step 13 Testing + Versioning + Production
APP_ENV=development
STEP13_EXPOSE_DOCS=true
STEP13_FORCE_HTTPS=false
STEP13_TRUSTED_HOSTS=
STEP13_REQUIRE_NONEMPTY_GRAPH=true
STEP13_REQUIRE_SUPABASE=true
RELEASE_COMMIT=
RELEASE_BUILD_TIME=

# Supabase-backed Knowledge Graph projection (recommended for Render/Vercel)
GRAPH_BACKEND=supabase
SUPABASE_GRAPH_NODES_TABLE=kg_nodes
SUPABASE_GRAPH_RELATIONSHIPS_TABLE=kg_relationships

# Standalone management portal (Ontology Studio + Organization Onboarding)
MANAGEMENT_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Step 12 one-click organization upload -> Supabase raw store -> Knowledge Graph
MULTI_ORG_PERSIST_UPLOADS_TO_SUPABASE=true
MULTI_ORG_DATASETS_TABLE=org_ingestion_datasets
MULTI_ORG_ROWS_TABLE=org_ingestion_rows
MULTI_ORG_SUPABASE_BATCH_SIZE=500
MULTI_ORG_AUTO_MAP_MIN_CONFIDENCE=0.94
MULTI_ORG_MAX_UPLOAD_MB=20

# Knowledge-Graph-only runtime (Step 9.1 compatibility projection)
# Bootstrap Data/*.csv into the reserved KG runtime mirror once, then enable these.
KG_RUNTIME_DATA_SOURCE=knowledge_graph
KG_LLM_GRAPH_ONLY=true
KG_RUNTIME_MIRROR_TENANT_PREFIX=__KG_RUNTIME__::
KG_RUNTIME_BATCH_SIZE=500
KG_RUNTIME_CACHE_DIR=/tmp/hr-workforce-kg-runtime
KG_RUNTIME_BOOTSTRAP_SOURCE_DIR=Data
KG_EXPOSE_RUNTIME_SOURCE=true
# In KG-only mode Step9 is forced to graph_only and legacy fallback is disabled.
STEP9_RUNTIME_MODE=graph_only
STEP9_ALLOW_LEGACY_FALLBACK=false
