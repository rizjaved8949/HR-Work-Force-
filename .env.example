OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

OPENROUTER_TEMPERATURE=0
OPENROUTER_MAX_TOKENS=1200
OPENROUTER_MAX_RETRIES=3
OPENROUTER_TIMEOUT_SECONDS=120
OPENROUTER_REASONING=off

DATA_DIR=Data
MODEL_PATH=models/catboost_attrition_model.cbm

SUCCESSOR_LLM_ENABLED=false
SUCCESSOR_OPENROUTER_TIMEOUT_SECONDS=90
SUCCESSOR_OPENROUTER_MAX_TOKENS=900
# Comma-separated frontend origins allowed to call this API from a browser.
# "*" allows any origin, which is safe here only because there are no cookies.
# Supabase Authentication
AUTH_ENABLED=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
AUTH_PUBLIC_PATHS=/health,/openapi.json
AUTH_PUBLIC_PREFIXES=/docs,/redoc

