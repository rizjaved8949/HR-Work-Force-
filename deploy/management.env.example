# Standalone management portal
GRAPH_BACKEND=supabase
SUPABASE_GRAPH_NODES_TABLE=kg_nodes
SUPABASE_GRAPH_RELATIONSHIPS_TABLE=kg_relationships
STEP9_TENANT_ID=ORGANIZATION-001

# Existing Supabase project
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SERVICE_ROLE_SECRET

# Main Vercel HR frontend origin; comma-separated if multiple.
MANAGEMENT_ALLOWED_ORIGINS=https://your-hr-frontend.vercel.app

# Keep false for local/demo unless you implement a cross-origin login/session
# handoff for this separately deployed management portal.
AUTH_ENABLED=false
