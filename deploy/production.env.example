# Step 13 production overlay. Merge with your secret manager/environment.
APP_ENV=production
ALLOWED_ORIGINS=https://your-frontend.example.com
AUTH_ENABLED=true
STEP9_RUNTIME_MODE=graph_first
STEP9_ALLOW_LEGACY_FALLBACK=true
STEP12_DEFAULT_TENANT_OPEN_ACCESS=false
STEP13_EXPOSE_DOCS=false
STEP13_FORCE_HTTPS=false
STEP13_TRUSTED_HOSTS=api.example.com
STEP13_REQUIRE_NONEMPTY_GRAPH=true
STEP13_REQUIRE_SUPABASE=true

# Knowledge Graph storage: no separate Neo4j service is required.
GRAPH_BACKEND=supabase
SUPABASE_GRAPH_NODES_TABLE=kg_nodes
SUPABASE_GRAPH_RELATIONSHIPS_TABLE=kg_relationships
RELEASE_COMMIT=
RELEASE_BUILD_TIME=

# Latency-safe LLM defaults. Keep the API key in your secret manager.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEMPERATURE=0
OPENROUTER_MAX_TOKENS=800
OPENROUTER_MAX_RETRIES=1
OPENROUTER_TIMEOUT_SECONDS=45
OPENROUTER_REASONING=off
SUCCESSOR_LLM_ENABLED=false
SUCCESSOR_OPENROUTER_TIMEOUT_SECONDS=50
SUCCESSOR_OPENROUTER_MAX_TOKENS=600

# Durable LangGraph conversation memory in the existing Supabase project.
USE_AGENT_SUPABASE_MEMORY=true
REQUIRE_AGENT_SUPABASE_MEMORY=true

# Secrets are intentionally omitted:
# SUPABASE_URL
# SUPABASE_PUBLISHABLE_KEY
# SUPABASE_SECRET_KEY
# Neo4j variables are optional only if you deliberately switch GRAPH_BACKEND=neo4j.
# OPENROUTER_API_KEY
