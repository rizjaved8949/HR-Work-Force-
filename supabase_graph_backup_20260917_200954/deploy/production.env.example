# Step 13 production overlay. Merge with your secret manager/environment.
APP_ENV=production
ALLOWED_ORIGINS=https://your-frontend.example.com
AUTH_ENABLED=true
STEP9_RUNTIME_MODE=graph_first
STEP9_ALLOW_LEGACY_FALLBACK=true
STEP12_DEFAULT_TENANT_OPEN_ACCESS=false
STEP13_EXPOSE_DOCS=false
STEP13_FORCE_HTTPS=false
STEP13_TRUSTED_HOSTS=api.example.com
STEP13_REQUIRE_NONEMPTY_GRAPH=true
STEP13_REQUIRE_SUPABASE=true
RELEASE_COMMIT=
RELEASE_BUILD_TIME=

# Secrets are intentionally omitted:
# SUPABASE_SECRET_KEY
# NEO4J_PASSWORD
# OPENROUTER_API_KEY
